{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-terra",
  "providers": {
    "anthropic": {
      "models": {
        "claude-sonnet-4-6": {
          "limit": { "context": 200000, "output": 128000 },
        },
        "claude-opus-4-6": {
          "limit": { "context": 200000, "output": 128000 },
        },
      },
    },
    "openai": {
      "models": {
        "gpt-5.4": {
          "limit": { "context": 200000, "output": 128000 },
        },
        "gpt-5.3-codex": {
          "limit": { "context": 200000, "output": 128000 },
        },
      },
    },
  },
  "permissions": [
    { "action": "external_directory", "resource": "~/github.com/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/cf/**", "effect": "allow" },
    { "action": "edit", "resource": "~/cf/stratus/**", "effect": "allow" },
    { "action": "question", "resource": "*", "effect": "deny" },

    // Generic shell commands
    { "action": "shell", "resource": "cat *", "effect": "allow" },
    { "action": "shell", "resource": "echo *", "effect": "allow" },
    { "action": "shell", "resource": "find *", "effect": "allow" },
    { "action": "shell", "resource": "grep *", "effect": "allow" },
    { "action": "shell", "resource": "head *", "effect": "allow" },
    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "pwd", "effect": "allow" },
    { "action": "shell", "resource": "rg *", "effect": "allow" },
    { "action": "shell", "resource": "sg *", "effect": "allow" },
    { "action": "shell", "resource": "rm *", "effect": "deny" },
    { "action": "shell", "resource": "trash *", "effect": "ask" },
    { "action": "shell", "resource": "which *", "effect": "allow" },
    { "action": "shell", "resource": "whoami", "effect": "allow" },

    // curl
    { "action": "shell", "resource": "curl -X DELETE *", "effect": "ask" },
    { "action": "shell", "resource": "curl -X PATCH *", "effect": "ask" },
    { "action": "shell", "resource": "curl -X POST *", "effect": "ask" },
    { "action": "shell", "resource": "curl -X PUT *", "effect": "ask" },

    // Git
    { "action": "shell", "resource": "git blame *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "git show *", "effect": "allow" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },

    // GitHub CLI
    { "action": "shell", "resource": "gh api --method DELETE *", "effect": "ask" },
    { "action": "shell", "resource": "gh api --method PATCH *", "effect": "ask" },
    { "action": "shell", "resource": "gh api --method POST *", "effect": "ask" },
    { "action": "shell", "resource": "gh api --method PUT *", "effect": "ask" },
    { "action": "shell", "resource": "gh api -X DELETE *", "effect": "ask" },
    { "action": "shell", "resource": "gh api -X PATCH *", "effect": "ask" },
    { "action": "shell", "resource": "gh api -X POST *", "effect": "ask" },
    { "action": "shell", "resource": "gh api -X PUT *", "effect": "ask" },
    { "action": "shell", "resource": "gh issue close *", "effect": "ask" },
    { "action": "shell", "resource": "gh issue comment *", "effect": "ask" },
    { "action": "shell", "resource": "gh issue create *", "effect": "ask" },
    { "action": "shell", "resource": "gh issue edit *", "effect": "ask" },
    { "action": "shell", "resource": "gh pr close *", "effect": "ask" },
    { "action": "shell", "resource": "gh pr comment *", "effect": "ask" },
    { "action": "shell", "resource": "gh pr create *", "effect": "ask" },
    { "action": "shell", "resource": "gh pr merge *", "effect": "ask" },
    { "action": "shell", "resource": "gh pr review *", "effect": "ask" },

    // GitLab CLI
    { "action": "shell", "resource": "glab mr note *", "effect": "ask" },

    // agent-browser
    { "action": "shell", "resource": "agent-browser *", "effect": "allow" },
    { "action": "shell", "resource": "agent-browser auth *", "effect": "ask" },
    { "action": "shell", "resource": "agent-browser state *", "effect": "ask" },
    { "action": "shell", "resource": "agent-browser eval *", "effect": "ask" },
    { "action": "shell", "resource": "agent-browser set credentials *", "effect": "ask" },
    { "action": "shell", "resource": "agent-browser cookies *", "effect": "ask" },
    { "action": "shell", "resource": "agent-browser download *", "effect": "ask" },
    { "action": "shell", "resource": "agent-browser upload *", "effect": "ask" },
    { "action": "shell", "resource": "agent-browser --allow-file-access *", "effect": "ask" },
    { "action": "shell", "resource": "agent-browser open file://*", "effect": "ask" },

    // npx agent-browser
    { "action": "shell", "resource": "npx agent-browser *", "effect": "ask" },
    { "action": "shell", "resource": "npx -y agent-browser@* *", "effect": "ask" },

    // Node.js / npm
    { "action": "shell", "resource": "bun install", "effect": "ask" },
    { "action": "shell", "resource": "bun publish *", "effect": "deny" },
    { "action": "shell", "resource": "npm install", "effect": "ask" },
    { "action": "shell", "resource": "npm publish *", "effect": "deny" },
    { "action": "shell", "resource": "pnpm install", "effect": "ask" },
    { "action": "shell", "resource": "pnpm publish *", "effect": "deny" },
    { "action": "shell", "resource": "yarn install", "effect": "ask" },
    { "action": "shell", "resource": "yarn publish *", "effect": "deny" },

  ],
  "plugins": ["@plannotator/opencode@latest", "github:eli0shin/opencode-tree"],
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
        "disabled": true,
      },
      "xcodebuild-mcp": {
        "type": "local",
        "command": ["npx", "-y", "xcodebuildmcp@latest", "mcp"],
        "disabled": true,
      },
    },
  },
}
